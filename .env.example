# =============================================================================
# medTrace Environment Configuration
# =============================================================================

# --- Gemini Flash OCR API Key ---
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# --- Free Email & OTP Services (Choose any one or use automatic Ethereal fallback) ---

# Option 1: Brevo (formerly Sendinblue) - 100% Free: 300 emails/day to ANY email
# Get free API key in 1 min at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=security@medtrace.health
EMAIL_FROM_NAME=medTrace Clinical Security

# Option 2: Free Gmail SMTP - 500 emails/day using your Gmail account
# Enable 2-Step Verification in Google Account -> Generate App Password (16 characters)
# at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option 3: Resend API - 100 free emails/day
# Get free API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM=medTrace Security <onboarding@resend.dev>

# Option 4: Custom SMTP Relay (e.g. Mailjet, SendGrid, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Note: If no credentials are provided, medTrace automatically uses Ethereal Sandbox
# which delivers the email to a live web preview inbox and provides a one-click auto-fill code in the UI.
